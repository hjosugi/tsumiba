{
  "manifest_version": 3,
  "name": "tsumiba",
  "version": "__VERSION__",
  "description": "Send pages, selections, links and images to your tsumiba shelf.",
  "homepage_url": "https://hjosugi.github.io/tsumiba/",
  "icons": {
    "16": "icons/tsumiba-16.png",
    "32": "icons/tsumiba-32.png",
    "48": "icons/tsumiba-48.png",
    "128": "icons/tsumiba-128.png"
  },
  "action": {
    "default_title": "tsumiba",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tsumiba-16.png",
      "32": "icons/tsumiba-32.png",
      "48": "icons/tsumiba-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Send the current page to tsumiba"
    }
  }
}
